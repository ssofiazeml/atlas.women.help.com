# Supabase configuration for Atlas
# Replace with your project credentials
# DO NOT commit .env.local with real keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY-HERE

# Optional future service key ONLY for one-time local seed script (never deploy or expose)
# SERVICE_ROLE_KEY=...
