# Supabase configuration for Atlas
# Replace with your project credentials
# DO NOT commit .env.local with real keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY-HERE
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY-HERE
VITE_OWNER_EMAIL=owner@example.com

# Optional future service key ONLY for one-time local seed script (never deploy or expose)
# SERVICE_ROLE_KEY=...

# The secret-admin password is a Supabase Edge Function secret named
# ATLAS_ADMIN_PASSWORD. Never expose it through a VITE_* variable.
